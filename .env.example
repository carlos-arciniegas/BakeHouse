# Copia este archivo como .env.local y completa con los datos de tu proyecto de Supabase
# (Project Settings → API). Usa la clave PÚBLICA (publishable / anon), nunca la secreta (service_role).
# Sin estas variables la app funciona igual, solo en el dispositivo.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
